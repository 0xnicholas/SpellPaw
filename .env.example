# --- Database ---
DATABASE_URL="postgresql://spellpaw:spellpaw@localhost:5433/spellpaw"
TEST_DATABASE_URL="postgresql://spellpaw:spellpaw@localhost:5433/spellpaw_test"

# --- Queue ---
REDIS_URL="redis://localhost:6379"

# --- Auth.js (v5) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
# Dev only: magic links are printed to the server console instead of emailed.
AUTH_EMAIL_DEV_MODE="true"

# --- Encryption (AES-256-GCM key for OAuth tokens, base64 32 bytes) ---
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=""

# --- Channel OAuth (Twitter/X) ---
# Set CLIENT_ID + CLIENT_SECRET for the REAL Twitter adapter (OAuth 2.0 + PKCE,
# scope tweet.read tweet.write users.read offline.access). Leave unset to use
# the MockAdapter (local dev/tests). Requires a Twitter Developer app (Free
# tier: https://developer.twitter.com/en/portal). The redirect URI below is a
# dev reference — the callback URL must ALSO be registered in the app's
# OAuth settings; the runtime derives it from the request host.
TWITTER_CLIENT_ID=""
TWITTER_CLIENT_SECRET=""
TWITTER_OAUTH_REDIRECT_URI="http://localhost:3000/api/channels/twitter/callback"

# --- Free-plan guardrails (M5, ADR-0012; 0 = unlimited) ---
FREE_PLAN_MAX_CHANNELS="3"
FREE_PLAN_MAX_POSTS="50"
FREE_PLAN_MAX_CONTACTS="1000"

# --- MCP write daily cap (default 100) ---
MCP_WRITE_DAILY_CAP="100"

# --- Contact State thresholds (M7-A, ADR-0015; all env-tunable) ---
# Engagement → ENGAGED at this many Content Touches within the window.
ENGAGE_THRESHOLD_TOUCHES="3"
ENGAGE_WINDOW_DAYS="30"
# LOYAL requires interaction in each of this many recent calendar months.
LOYAL_MONTHS="3"
# Silence thresholds for risk decay (days).
AT_RISK_DAYS="30"
CHURNED_DAYS="90"
# Daily decay cron (BullMQ pattern) + scan batch size.
STATE_DECAY_CRON="0 3 * * *"
STATE_DECAY_BATCH="500"

# --- Persona derivation batch (M7-C, ADR-0015) ---
# Cadence for the dirty-flag scan (default hourly, per ADR-0003) + batch size.
# Derivation only runs when a Workspace enables personaDerivationEnabled
# (content-egress gate; off by default).
PERSONA_BATCH_CRON="0 * * * *"
PERSONA_BATCH_SIZE="50"
