# --- Database ---
DATABASE_URL="postgresql://spellpaw:spellpaw@localhost:5433/spellpaw"
TEST_DATABASE_URL="postgresql://spellpaw:spellpaw@localhost:5433/spellpaw_test"

# --- Queue ---
REDIS_URL="redis://localhost:6379"

# --- Auth.js (v5) ---
# Generate with: openssl rand -base64 32
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"
# Dev only: magic links are printed to the server console instead of emailed.
AUTH_EMAIL_DEV_MODE="true"

# --- Encryption (AES-256-GCM key for OAuth tokens, base64 32 bytes) ---
# Generate with: openssl rand -base64 32
ENCRYPTION_KEY=""

# --- Channel OAuth (Twitter/X) ---
# Leave unset to use the MockAdapter (dev/test). Set all four for the real flow.
TWITTER_CLIENT_ID=""
TWITTER_CLIENT_SECRET=""
TWITTER_OAUTH_REDIRECT_URI="http://localhost:3000/api/channels/twitter/callback"

# --- Free-plan guardrails (M5, ADR-0012; 0 = unlimited) ---
FREE_PLAN_MAX_CHANNELS="3"
FREE_PLAN_MAX_POSTS="50"
FREE_PLAN_MAX_CONTACTS="1000"

# --- MCP write daily cap (default 100) ---
MCP_WRITE_DAILY_CAP="100"
