// SpellPaw Phase 1 — M1 data model.
// See docs/design/spellpaw-phase1-implementation.md §1 for the full Phase 1 model.
// M1 scope: Workspace, Channel, OAuthConnection, Post, PostVariant.
// Contact/ContentTouch arrive with short-link tracking (M4); Conversation/Event with Inbox (Phase 2).

generator client {
  provider = "prisma-client"
  output   = "../src/generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum PostStatus {
  DRAFT
  SCHEDULED
  PUBLISHED
}

enum PublishState {
  DRAFT
  PUBLISHED
  FAILED
}

model Workspace {
  id                 String             @id @default(cuid())
  // Auth.js user id (JWT session) — Account entity is owned by Auth.js in M1.
  accountId          String
  name               String
  // MCP publish approval (spec §3): while true, schedule/publish tools via
  // MCP reject with a "requires approval" error — the web UI is the approved
  // path. Users can switch to trusted mode here (M5 decision, ADR-0012).
  mcpPublishApproval Boolean            @default(true)
  // M6 (ADR-0014): PII-exception gate for the MCP inbox module (default false =
  // inbox.* tools reject). Deliberately separate from mcpPublishApproval —
  // different default posture, different tool family.
  mcpInboxAccess    Boolean            @default(false)
  createdAt          DateTime           @default(now())
  posts              Post[]
  oauthConnections   OAuthConnection[]
  modelProviderKeys  ModelProviderKey[]
  apiTokens          ApiToken[]
  contacts           Contact[]
  shortLinks         ShortLink[]
  conversations      Conversation[]
  readStates         InboxReadState[]
  events             Event[]

  @@index([accountId])
}

// --- Auth.js adapter models (email magic link persists verification tokens) ---

model User {
  id            String    @id @default(cuid())
  email         String    @unique
  emailVerified DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  accounts      Account[]
  sessions      Session[]
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model Channel {
  id            String            @id @default(cuid())
  slug          String            @unique
  name          String
  connections   OAuthConnection[]
  variants      PostVariant[]
  conversations Conversation[]
  readStates    InboxReadState[]
}

model OAuthConnection {
  id           String    @id @default(cuid())
  workspaceId  String
  channelId    String
  // AES-256-GCM encrypted at rest (ENCRYPTION_KEY). See src/lib/crypto.ts.
  accessToken  String
  refreshToken String?
  expiresAt    DateTime?
  // Human-readable account name on the platform (e.g. "@handle" on X).
  // Cosmetic — fetched at connect time, never blocks the connection.
  accountName  String?
  connectedAt  DateTime  @default(now())

  channel   Channel   @relation(fields: [channelId], references: [id])
  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@unique([workspaceId, channelId])
}

model Post {
  id          String     @id @default(cuid())
  workspaceId String
  title       String?
  status      PostStatus @default(DRAFT)
  scheduledAt DateTime?
  publishedAt DateTime?
  createdAt   DateTime   @default(now())
  updatedAt   DateTime   @updatedAt

  workspace     Workspace      @relation(fields: [workspaceId], references: [id])
  variants      PostVariant[]
  shortLinks    ShortLink[]
  touches       ContentTouch[]
  conversations Conversation[]

  @@index([workspaceId, status])
  @@index([workspaceId, scheduledAt])
}

model PostVariant {
  id           String       @id @default(cuid())
  postId       String
  channelId    String
  content      String       @default("")
  charCount    Int          @default(0)
  publishState PublishState @default(DRAFT)
  publishedAt  DateTime?
  // Platform-side id of the published content (e.g. the tweet id on X).
  externalId   String?
  errorMessage String?

  post      Post       @relation(fields: [postId], references: [id])
  channel   Channel    @relation(fields: [channelId], references: [id])
  shortLink ShortLink?

  @@unique([postId, channelId])
}

// --- M4: Interaction tables (spec §1) + short links (ADR-0009) ---
// Deviation notes (vs spec sketch): ShortLink carries workspaceId + variantId
// (links are workspace-scoped and attributed per channel variant);
// ContentTouch.contactId is nullable because cookie-blocked clicks are still
// counted (anonymous).

enum TouchAction {
  CLICK
  LIKE
  SHARE
}

model ShortLink {
  id          String   @id @default(cuid())
  workspaceId String
  code        String   @unique
  targetUrl   String
  postId      String
  variantId   String   @unique
  createdAt   DateTime @default(now())

  workspace Workspace   @relation(fields: [workspaceId], references: [id])
  post      Post        @relation(fields: [postId], references: [id])
  variant   PostVariant @relation(fields: [variantId], references: [id])

  @@index([workspaceId, createdAt])
}

model ContentTouch {
  id        String      @id @default(cuid())
  contactId String?
  postId    String
  variantId String?
  action    TouchAction @default(CLICK)
  timestamp DateTime    @default(now())

  contact Contact? @relation(fields: [contactId], references: [id])
  post    Post     @relation(fields: [postId], references: [id])

  @@index([contactId, timestamp])
  @@index([postId, timestamp])
  @@index([variantId, timestamp])
}

enum ConvDirection {
  INBOUND
  OUTBOUND
}

// Inbox Phase 1 (ADR-0013): row-as-message — each Conversation row is ONE
// message exchange (direction + content + timestamp). The "conversation" a
// user sees in the Inbox list is a query-time aggregation over
// contact × channel, not a first-class entity.
// externalId = platform-side message id (mock ids for simulated comments,
// tweet ids once real X inbound lands) — unique for dedup/idempotency.
// postId = the Post this message replies to (comment pipeline).
enum DeliveryState {
  PENDING
  SENT
  FAILED
}

model Conversation {
  id          String        @id @default(cuid())
  workspaceId String
  contactId   String
  channelId   String
  postId      String?
  content     String
  externalId  String        @unique
  direction   ConvDirection
  // Outbound delivery state (M6): PENDING while queued, SENT on adapter
  // success, FAILED terminal (permanent error, no retry — replies never
  // auto-retry beyond one transient retry to avoid duplicate replies).
  // Inbound rows stay SENT.
  deliveryState DeliveryState @default(SENT)
  errorMessage  String?
  timestamp     DateTime      @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  contact   Contact   @relation(fields: [contactId], references: [id])
  channel   Channel   @relation(fields: [channelId], references: [id])
  post      Post?     @relation(fields: [postId], references: [id])

  @@index([contactId, timestamp])
  @@index([workspaceId, channelId, timestamp])
}

// User consumption state for the Inbox list (ADR-0013): "read" cannot be
// derived from timestamps — it records the last time the user viewed a
// contact×channel thread. Not a conversation model, just a read cursor.
model InboxReadState {
  id          String   @id @default(cuid())
  workspaceId String
  contactId   String
  channelId   String
  lastReadAt  DateTime @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  contact   Contact   @relation(fields: [contactId], references: [id])
  channel   Channel   @relation(fields: [channelId], references: [id])

  @@unique([contactId, channelId])
}

enum EventType {
  REGISTER
  SUBSCRIBE
  UPGRADE
  LOGIN
  // Manual activation (M6 Inbox): user marks a contact Activated in the UI/API.
  MANUAL_ACTIVATION
}

model Event {
  id             String    @id @default(cuid())
  workspaceId    String
  contactId      String
  eventType      EventType
  externalSource String?
  timestamp      DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])
  contact   Contact   @relation(fields: [contactId], references: [id])

  @@index([contactId, timestamp])
}

// --- M3: AI Provider (BYOK, ADR-0005) ---

model ModelProviderKey {
  id           String    @id @default(cuid())
  workspaceId  String
  provider     String // "openai" | "anthropic"
  // AES-256-GCM encrypted at rest (ENCRYPTION_KEY). See src/lib/crypto.ts.
  encryptedKey String
  keyPreview   String // "sk-...a1b2"
  isActive     Boolean   @default(true)
  lastChecked  DateTime?
  createdAt    DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId, isActive])
}

// Workspace-scoped bearer tokens for external MCP/AI clients (Claude Desktop etc.).
// Only the SHA-256 hash is stored; the plaintext token is shown once at mint time.
model ApiToken {
  id          String    @id @default(cuid())
  workspaceId String
  name        String
  tokenHash   String    @unique
  // "sp_" + 32 random base58 chars — shown once at creation.
  lastUsedAt  DateTime?
  revokedAt   DateTime?
  createdAt   DateTime  @default(now())

  workspace Workspace @relation(fields: [workspaceId], references: [id])

  @@index([workspaceId, revokedAt])
}

// --- M3: Customer Graph (schema-only until M4 writes data) ---

enum ContactType {
  AUDIENCE
  CORRESPONDENT
}

enum LifecycleStage {
  AWARE
  ENGAGED
  ACTIVATED
  LOYAL
  AT_RISK
  CHURNED
}

model Contact {
  id          String      @id @default(cuid())
  workspaceId String
  // Event-triggered: AUDIENCE -> CORRESPONDENT on first Conversation (Phase 2).
  type        ContactType @default(AUDIENCE)

  // Profile (PII, user-editable) — MCP contact tools must NEVER select these.
  profileName          String?
  profileEmail         String?
  profileSocialHandle  String?
  profileSourceChannel String?
  profileTags          String[]

  // Persona (AI-derived, no PII, 365-day window) — populated by M4 derivation.
  personaContentDNA   Json?
  personaSentimentArc Json?
  personaIntentVector Float[] // pgvector

  // State (real-time, rules-driven) — recomputed on Interaction events.
  stateLifecycleStage   LifecycleStage @default(AWARE)
  stateRiskScore        Int?
  stateOpportunityScore Int?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  workspace     Workspace        @relation(fields: [workspaceId], references: [id])
  touches       ContentTouch[]
  conversations Conversation[]
  readStates    InboxReadState[]
  events        Event[]

  @@index([workspaceId, stateLifecycleStage])
  @@index([workspaceId, updatedAt])
}
